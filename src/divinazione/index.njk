---
layout: base.njk
permalink: /divinazione/
title: "Guide di Divinazione"
crumb:
  href: /
  label: Home
---
<div class="page-hero divination-hero">
  <div class="divination-hero-copy">
    <p class="eyebrow section-eyebrow">L’arte di leggere i segni</p>
    <h1>Dodici metodi</h1>
    <p>Dodici guide per arricchire le scene di divinazione: strumenti, rituali e interpretazioni da consultare durante il gioco.</p>
  </div>
</div>

<section class="divination-catalog" aria-label="Metodi di divinazione">
  <div class="card-grid divination-grid">
    {% for m in metodi %}
      {% if m.stato == "live" %}
      <a class="card catalog-card divination-card" href="/divinazione/{{ m.slug }}/">
      {% else %}
      <div class="card catalog-card divination-card disabled">
      {% endif %}
        <div class="catalog-card-top"><span class="icon"><i class="{{ m.icona }}"></i></span></div>
        <h3>{{ m.titolo }}</h3>
        <p>{{ m.sintesi }}</p>
        <span class="catalog-card-action">{% if m.stato == "live" %}Apri la guida{% else %}In arrivo{% endif %}<span aria-hidden="true">{% if m.stato == "live" %}↗{% else %}—{% endif %}</span></span>
      {% if m.stato == "live" %}
      </a>
      {% else %}
      </div>
      {% endif %}
    {% endfor %}
  </div>
</section>
