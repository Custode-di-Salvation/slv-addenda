        <div class="scry-mist scry-mist-2"></div>
      </div>
      <button class="btn-draw" id="scryBtn" type="button">Scruta la superficie</button>
    </div>
    <div class="scry-result" id="scryResult" hidden>
      <strong id="scrySymbol"></strong>
      <p id="scryMeaning"></p>
    </div>
  </div>
</section>

