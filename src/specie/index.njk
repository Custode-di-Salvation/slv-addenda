---
layout: base.njk
title: "Specie"
permalink: "/specie/index.html"
styles: ["/css/specie.css"]
---
<div class="page-hero">
  <p class="eyebrow section-eyebrow">Poteri e avversioni</p>
  <h1>Specie</h1>
  <p>Caratteristiche, poteri e avversioni delle specie giocabili non umane: una scheda per specie, con la stessa struttura del regolamento.</p>
</div>


<div id="specieCards">
  {% set categorie = [
    { titolo: "Entità energetiche", slugs: ["angeli", "caduti", "demoni", "djinn", "fantasmi"] },
    { titolo: "Ibridi", slugs: ["cambion", "nephilim"] },
    { titolo: "Teriantropi", slugs: ["licantropi", "skinwalkers", "wendigo"] },
    { titolo: "Non-morti", slugs: ["vampiri"] },
    { titolo: "Chimere", slugs: ["arachne", "arpie", "faelan", "gorgoni", "maridi"] },
    { titolo: "Metaumani", slugs: ["aoristi", "artefici", "chiaroveggenti", "lettori-animici", "lettori-empatici", "lettori-telepatici", "medium", "riemersi"] },
    { titolo: "Esseri primordiali", slugs: ["fae", "fenici", "mietitori"] }
  ] %}

  {% for cat in categorie %}
  <div class="specie-group-title">
    <h2>{{ cat.titolo }}</h2>
  </div>
  <div class="card-grid{% if cat.titolo == "Entità energetiche" or cat.titolo == "Chimere" %} energetic-species-grid{% endif %}">
    {% for slug in cat.slugs %}
      {% set sp = null %}
      {% for item in specie %}
        {% if item.slug == slug %}{% set sp = item %}{% endif %}
      {% endfor %}
      
      {% if sp %}
      <a class="card catalog-card divination-card species-card" href="/specie/{{ sp.slug }}/">
        <div class="catalog-card-top"><span class="icon" aria-hidden="true"><i class="{{ sp.icona }}"></i></span></div>
        <h3>{{ sp.nome }}</h3>
        <p>{{ sp.tagline }}</p>
        <span class="catalog-card-action">Apri la specie <span aria-hidden="true">↗</span></span>
      </a>
      {% elif slug == "djinn" %}
      <div class="card catalog-card divination-card species-card" style="opacity: 0.6; cursor: not-allowed;">
        <div class="catalog-card-top"><span class="icon" aria-hidden="true"><i class="fa-solid fa-fire-flame-curved"></i></span></div>
        <h3>Djinn</h3>
        <p>Caratteristiche, poteri di specie, avversioni e debolezze dei djinn.</p>
        <span class="catalog-card-action" style="color: var(--text-soft)">In arrivo</span>
      </div>
      {% elif slug == "mietitori" %}
      <div class="card catalog-card divination-card species-card" style="opacity: 0.6; cursor: not-allowed;">
        <div class="catalog-card-top"><span class="icon" aria-hidden="true"><i class="fa-solid fa-skull"></i></span></div>
        <h3>Mietitori</h3>
        <p>Caratteristiche, poteri di specie, avversioni e debolezze dei mietitori.</p>
        <span class="catalog-card-action" style="color: var(--text-soft)">In arrivo</span>
      </div>
      {% endif %}
    {% endfor %}
  </div>
  {% endfor %}
</div>
