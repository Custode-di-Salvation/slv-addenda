 // --- helpers: riferimenti [Skill] e sinergie --- 
 const baseName = n => n.split('*')[0].trim(); 
 const skillByBase = {}; 
 skills.forEach(s => { skillByBase[baseName(s.name).toLowerCase()] = s.name; }); 
 
 function linkifyRefs(html) { 
 return html.replace(/\[([^\]\[<>]{2,60})\]/g, (m, inner) => { 
 const base = inner.split(':')[0].trim().toLowerCase(); 
 const target = skillByBase[base]; 
 return target ? '<a class="skill-ref" data-ref="' + target + '">[' + inner + ']</a>' : m; 
 }); 
 } 
 
 function extractSynergies(skill) { 
 const text = skill.description; 
 const self = baseName(skill.name).toLowerCase(); 
 const found = []; 
 const re = /sinergia/gi; let m; 
 while ((m = re.exec(text))) { 
 const win = text.slice(Math.max(0, m.index - 100), m.index + 120); 
 (win.match(/\[([^\]\[<>]+)\]/g) || []).forEach(r => { 
 const inner = r.slice(1, -1).trim(); 
 const base = inner.split(':')[0].trim().toLowerCase(); 
 if (skillByBase[base] && base !== self && !found.some(f => f.toLowerCase() === inner.toLowerCase())) found.push(inner); 
 }); 
 } 
 return found; 
 } 
 
 function createSkillCard(skill) { 
 const card = document.createElement('div'); 
 card.className = 'skill-card'; 
 card.dataset.type = skill.type; 
 card.dataset.name = skill.name; 
 card.dataset.special = skill.name.includes('*') ? '1' : ''; 
 
 const levelDots = Array(5).fill('').map((_, i) => 
 '<div class="level-dot' + (i < skill.level ? ' filled' : '') + '"></div>' 
 ).join(''); 
 
 const synergies = extractSynergies(skill); 
 const synHtml = synergies.length ? 
 '<div class="skill-syn"><span class="skill-syn-label">Sinergie</span>' + 
 synergies.map(s => '<a class="skill-ref" data-ref="' + skillByBase[s.split(':')[0].trim().toLowerCase()] + '">' + s + '</a>').join('') + 
 '</div>' : ''; 
 
 card.innerHTML = 
 '<div class="skill-header">' + 
 '<div class="skill-icon"><i class="' + skill.icon + '"></i></div>' + 
 '<div class="skill-name">' + skill.name + '</div>' + 
 (skill.examples ? '<button class="examples-btn" data-skill="' + skill.name + '" title="Esempi d\'uso"><i class="fa-solid fa-lightbulb"></i></button>' : '') + 
 '</div>' + 
 '<div class="skill-description">' + linkifyRefs(skill.description) + '</div>' + 
 synHtml + 
 '<div class="skill-footer">' + 
 '<div class="skill-type">' + skill.type + '</div>' + 
 '<div class="skill-level-container">' + 
 '<div class="skill-level-text">livello standard <i class="fa-solid fa-arrow-right"></i></div>' + 
 '<div class="skill-level">' + 
 levelDots + 
 '</div>' + 
 '</div>' + 
 '</div>'; 
 
 return card; 
} 
 
 let onlySpecial = false; 
 
 function filterSkills() { 
 const searchTerm = document.getElementById('searchInput').value.toLowerCase(); 
 const activeType = document.querySelector('.filter-btn.active[data-type]').dataset.type; 
 let visible = 0; 
 
 const cards = document.querySelectorAll('.skill-card'); 
 cards.forEach(card => { 
 const skillName = card.querySelector('.skill-name').textContent.toLowerCase(); 
 const skillDesc = card.querySelector('.skill-description').textContent.toLowerCase(); 
 const skillType = card.dataset.type; 
 
 const matchesSearch = skillName.includes(searchTerm) || skillDesc.includes(searchTerm); 
 const matchesType = activeType === 'all' || skillType === activeType; 
 const matchesSpecial = !onlySpecial || card.dataset.special === '1'; 
 
 const show = matchesSearch && matchesType && matchesSpecial; 
 card.style.display = show ? '' : 'none'; 
 if (show) visible++; 
 }); 
 
 document.getElementById('noResults').style.display = visible === 0 ? '' : 'none'; 
 
 const label = visible === 1 ? 'abilità mostrata' : 'abilità mostrate'; 
 document.getElementById('resultsCounter').textContent = visible + ' ' + label + ' su ' + cards.length; 
 } 
 
 function updateCategoryCounts() { 
 const counts = {}; 
 skills.forEach(skill => { 
 counts[skill.type] = (counts[skill.type] || 0) + 1; 
 }); 
 
 document.querySelectorAll('.filter-btn[data-type]').forEach(btn => { 
 const type = btn.dataset.type; 
 const count = type === 'all' ? skills.length : (counts[type] || 0); 
 const countSpan = document.createElement('span'); 
 countSpan.className = 'count'; 
 countSpan.textContent = count; 
 btn.appendChild(countSpan); 
 }); 
 
 const specialCount = skills.filter(s => s.name.includes('*')).length; 
 const specialSpan = document.createElement('span'); 
 specialSpan.className = 'count'; 
 specialSpan.textContent = specialCount; 
 document.getElementById('specialBtn').appendChild(specialSpan); 
 } 
 
 function jumpToSkill(name) { 
 const card = [...document.querySelectorAll('.skill-card')].find(c => c.dataset.name === name); 
 if (!card) return; 
 if (card.style.display === 'none') { 
 document.getElementById('searchInput').value = ''; 
 onlySpecial = false; 
 document.getElementById('specialBtn').classList.remove('active'); 
 document.querySelectorAll('.filter-btn[data-type]').forEach(b => b.classList.remove('active')); 
 document.querySelector('.filter-btn[data-type="all"]').classList.add('active'); 
 filterSkills(); 
 } 
 if (document.getElementById('skillsContainer').classList.contains('compact')) card.classList.add('expanded'); 
 card.scrollIntoView({behavior: 'smooth', block: 'center'}); 
 card.classList.add('highlight'); 
 setTimeout(() => card.classList.remove('highlight'), 1800); 
 } 
 
 document.addEventListener('DOMContentLoaded', () => { 
 const container = document.getElementById('skillsContainer'); 
 skills.forEach(skill => { 
 container.appendChild(createSkillCard(skill)); 
 }); 
 
 updateCategoryCounts(); 
 filterSkills(); 
 
 document.querySelectorAll('.filter-btn[data-type]').forEach(btn => { 
 btn.addEventListener('click', (e) => { 
 document.querySelectorAll('.filter-btn[data-type]').forEach(b => b.classList.remove('active')); 
 e.currentTarget.classList.add('active'); 
 filterSkills(); 
 }); 
 }); 
 
 document.getElementById('specialBtn').addEventListener('click', (e) => { 
 onlySpecial = !onlySpecial; 
 e.currentTarget.classList.toggle('active', onlySpecial); 
 filterSkills(); 
 }); 
 
 document.getElementById('viewBtn').addEventListener('click', (e) => { 
 const container = document.getElementById('skillsContainer'); 
 const compact = container.classList.toggle('compact'); 
 e.currentTarget.classList.toggle('active', compact); 
 if (!compact) container.querySelectorAll('.skill-card.expanded').forEach(c => c.classList.remove('expanded')); 
 }); 
 
document.getElementById('searchInput').addEventListener('input', filterSkills); 
 
document.querySelector('.close').addEventListener('click', closeModal); 
window.addEventListener('click', (e) => { 
 if (e.target === document.getElementById('examplesModal')) { 
 closeModal(); 
 } 
}); 
document.getElementById('modalPrev').addEventListener('click', () => modalStep(-1)); 
document.getElementById('modalNext').addEventListener('click', () => modalStep(1)); 
document.addEventListener('keydown', (e) => { 
 if (e.key === 'Escape') closeModal(); 
 if (document.getElementById('examplesModal').style.display === 'block') { 
 if (e.key === 'ArrowLeft') modalStep(-1); 
 if (e.key === 'ArrowRight') modalStep(1); 
 } 
}); 
 
let modalIndex = -1; 
 
function openModal(skillName) { 
 const i = skills.findIndex(s => s.name === skillName); 
 if (i < 0 || !skills[i].examples) return; 
 modalIndex = i; 
 const skill = skills[i]; 
 
 document.getElementById('modalIcon').className = skill.icon; 
 document.getElementById('modalTitle').textContent = skill.name; 
 document.getElementById('modalCount').textContent = (i + 1) + ' / ' + skills.length; 
 document.getElementById('noRollExamples').textContent = skill.examples.noRoll; 
 document.getElementById('rollRequiredExamples').textContent = skill.examples.rollRequired; 
 document.getElementById('sequenceExamples').textContent = skill.examples.sequences || 'Nessun esempio di sequenza disponibile.'; 
 
 document.getElementById('examplesModal').style.display = 'block'; 
} 
 
function modalStep(dir) { 
 if (modalIndex < 0) return; 
 openModal(skills[(modalIndex + dir + skills.length) % skills.length].name); 
} 
 
function closeModal() { 
 document.getElementById('examplesModal').style.display = 'none'; 
} 
 
document.getElementById('skillsContainer').addEventListener('click', (e) => { 
 const ref = e.target.closest('.skill-ref'); 
 if (ref) { 
 jumpToSkill(ref.dataset.ref); 
 return; 
 } 
 if (e.target.closest('.examples-btn')) { 
 const skillName = e.target.closest('.examples-btn').dataset.skill; 
 openModal(skillName); 
 return; 
 } 
 const desc = e.target.closest('.skill-description'); 
 if (desc && document.getElementById('skillsContainer').classList.contains('compact')) { 
 desc.closest('.skill-card').classList.toggle('expanded'); 
 } 
 }); 
 }); 
 </script>
